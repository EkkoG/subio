{
  // JSON5 supports comments, trailing commas, and single-quoted strings.
  version: 1,
  nodes: [
    {
      type: 'shadowsocks',
      name: 'json5-ss',
      server: 'json5-ss.example.test',
      port: 8388,
      cipher: 'aes-256-gcm',
      password: 'example-password',
    },
    {
      type: 'vless',
      name: 'json5-vless',
      server: 'json5-vless.example.test',
      port: 443,
      uuid: '00000000-0000-0000-0000-000000000012',
      tls: {enabled: true, server_name: 'json5-vless.example.test'},
      transport: {network: 'ws', path: '/example'},
    },
  ],
}
